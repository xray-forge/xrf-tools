{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./target/tsconfig.node.tsbuildinfo",
    // Checked separately from the app: Vite consumes shared theme sources directly, without declaration output.
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["vite.config.ts", "cli/build/**/*.ts", "package.json"]
}
