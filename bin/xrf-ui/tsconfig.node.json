{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./target/tsconfig.node.tsbuildinfo",
    // Emit is never consumed - vite loads its own config and jest requires the typescript directly - but a composite
    // project must be able to emit, and beside the sources a stale `.js` would shadow the `.ts` it was built from.
    "outDir": "./target/tsconfig-node",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["vite.config.ts", "cli/build/**/*.ts"]
}
