{
  "extends": "@xrf/toolchain/tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./target/tsconfig.node.tsbuildinfo",
    // Node loads these natively, so imports name their files and the app's `@/` alias does not exist here.
    "allowImportingTsExtensions": true
  },
  "include": ["vite.config.ts", "cli/build/**/*.ts", "package.json"]
}
