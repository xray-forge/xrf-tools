{
  "name": "xrf-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/xray-forge/xrf-tools.git"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "preview": "vite preview",
    "preview:prod": "pnpm run build && vite preview",
    "lint": "eslint . --config cli/lint/eslint.config.mjs --max-warnings 0 --cache --cache-location target/eslint/cache.json --cache-strategy content",
    "format": "prettier --write \"**/*.(js|ts|tsx|md)\" && pnpm run lint --fix",
    "generate:bindings": "cargo make --cwd ../.. generate-typescript",
    "format:bindings": "eslint --config cli/lint/eslint.generated.config.mjs --no-cache --fix src/core/ipc/commands src/core/ipc/types && prettier --write --log-level warn \"src/core/ipc/commands/**/*.ts\" \"src/core/ipc/types/**/*.ts\""
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@mui/x-data-grid": "^9.13.0",
    "@mui/x-tree-view": "^9.13.0",
    "@mui/x-virtualizer": "0.7.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@wirestate/core": "1.0.0",
    "@wirestate/mobx": "1.0.0",
    "@wirestate/react": "1.0.0",
    "@wirestate/react-mobx": "1.0.0",
    "@xyflow/react": "^12.11.6",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "3.7.0",
    "@xrf/math": "workspace:*",
    "@xrf/renderer": "workspace:*",
    "@xrf/types": "workspace:*"
  },
  "jest": {
    "preset": "./cli/test/jest.config.cjs"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@eslint/compat": "catalog:",
    "@jest/globals": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "@wirestate/dev": "1.0.0",
    "@xrf/toolchain": "workspace:*",
    "babel-plugin-observing-components": "^0.2.0",
    "eslint": "catalog:",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "4.4.0",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "mobx-react-observer": "^2.0.0",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "^8.3.0",
    "vite-plugin-inline-source": "^5.0.0"
  }
}
