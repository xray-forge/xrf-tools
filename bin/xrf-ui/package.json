{
  "name": "xrf-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/xray-forge/xrf-tools.git"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "preview": "vite preview",
    "preview:prod": "pnpm run build && vite preview",
    "lint": "eslint . --config cli/lint/eslint.config.mjs --max-warnings 0 --cache --cache-location target/eslint/cache.json --cache-strategy content",
    "format": "prettier --write \"**/*.(js|ts|tsx|md)\" && pnpm run lint --fix",
    "generate:bindings": "cargo make --cwd ../.. generate-typescript",
    "format:bindings": "eslint --config cli/lint/eslint.generated.config.mjs --no-cache --fix src/core/bindings && prettier --write --log-level warn \"src/core/bindings/**/*.ts\""
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@mui/x-data-grid": "^9.13.0",
    "@mui/x-tree-view": "^9.13.0",
    "@mui/x-virtualizer": "0.7.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@wirestate/core": "1.0.0-experimental.18",
    "@wirestate/mobx": "1.0.0-experimental.18",
    "@wirestate/react": "1.0.0-experimental.18",
    "@wirestate/react-mobx": "1.0.0-experimental.18",
    "@xyflow/react": "^12.11.6",
    "date-fns": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "three": "^0.186.0"
  },
  "jest": {
    "preset": "./cli/test/jest.config.cjs"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@wirestate/dev": "1.0.0-experimental.18",
    "babel-plugin-observing-components": "^0.2.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsdoc": "^64.3.9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "mobx-react-observer": "^2.0.0",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-inline-source": "^5.0.0"
  }
}
