{
  "name": "xrf-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "preview": "vite preview",
    "preview:prod": "pnpm run build && vite preview",
    "lint": "eslint . --config cli/lint/eslint.config.mjs --max-warnings 0 --cache --cache-location target/eslint/cache.json --cache-strategy content",
    "format": "prettier --write \"**/*.(js|ts|tsx|md)\" && pnpm run lint --fix",
    "generate:bindings": "cargo make --cwd ../.. generate-typescript",
    "format:bindings": "eslint --config cli/lint/eslint.generated.config.mjs --no-cache --fix src/core/bindings && prettier --write --log-level warn \"src/core/bindings/**/*.ts\""
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/system": "^9.3.0",
    "@mui/x-data-grid": "^9.12.0",
    "@mui/x-tree-view": "^9.12.0",
    "@mui/x-virtualizer": "0.7.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@wirestate/core": "^1.0.0-experimental.16",
    "@wirestate/mobx": "^1.0.0-experimental.16",
    "@wirestate/react": "^1.0.0-experimental.16",
    "@wirestate/react-mobx": "^1.0.0-experimental.16",
    "@xyflow/react": "^12.11.3",
    "date-fns": "^4.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "three": "^0.185.1"
  },
  "jest": {
    "preset": "./cli/test/jest.config.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^30.4.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@wirestate/dev": "^1.0.0-experimental.16",
    "babel-plugin-observing-components": "^0.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.15.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "mobx-react-observer": "^2.0.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.16",
    "vite-plugin-inline-source": "^5.0.0"
  }
}
