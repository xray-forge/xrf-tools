{
  "productName": "xrf-app",
  "version": "0.1.0",
  "identifier": "com.xrf.tools",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "pnpm run build",
      "cwd": "../ui"
    },
    "frontendDist": "../ui/target/dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../crates/xrf-renderer/assets/": "resources/renderer/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {},
  "app": {
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    },
    "windows": [
      {
        "title": "XRF tools",
        "create": false,
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#171717",
        "decorations": false,
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ]
  }
}
