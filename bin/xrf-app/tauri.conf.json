{
  "productName": "xrf-app",
  "version": "0.1.0",
  "identifier": "com.xrf.tools",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm run dev",
      "cwd": "../xrf-ui"
    },
    "beforeBuildCommand": {
      "script": "pnpm run build",
      "cwd": "../xrf-ui"
    },
    "frontendDist": "../xrf-ui/target",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {},
  "app": {
    "windows": [
      {
        "title": "XRF tools",
        "create": false,
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ]
  }
}
