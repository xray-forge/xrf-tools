{
  "name": "@xrf/toolchain",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The lint, test, format and compiler configuration every TypeScript member of the workspace extends.",
  "exports": {
    "./eslint": "./lint/eslint.base.mjs",
    "./jest": "./test/jest.base.cjs",
    "./prettier": "./prettier.config.mjs",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./workspace": "./workspace.cjs"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0 --cache --cache-location target/eslint/cache.json --cache-strategy content",
    "format": "prettier --write --ignore-path ../.prettierignore \"**/*.(js|cjs|mjs|json)\" && pnpm run lint --fix"
  },
  "dependencies": {
    "@eslint/compat": "catalog:",
    "@eslint/js": "^10.0.1",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsdoc": "^64.3.9",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:"
  }
}
