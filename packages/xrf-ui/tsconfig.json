{
  "extends": "@xrf/toolchain/tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./target/tsconfig.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
