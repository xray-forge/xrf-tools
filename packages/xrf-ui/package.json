{
  "name": "@xrf/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The application's look: its tokens, theme and stylesheets, and the component library it draws with.",
  "exports": {
    "./icons/*": "./src/icons/*.ts",
    "./theme/tailwind.css": "./src/theme/root/tailwind.css",
    "./*": "./src/*/index.ts"
  },
  "imports": {
    "#/icons/*": "./src/icons/*.ts",
    "#/*": "./src/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint . --max-warnings 0 --cache --cache-location target/eslint/cache.json --cache-strategy content",
    "storybook": "storybook dev --port 6006 --exact-port --no-open",
    "build:storybook": "storybook build --output-dir target/storybook",
    "format": "prettier --write --ignore-path ../../.prettierignore \"**/*.(js|cjs|mjs|ts|tsx|md)\" && pnpm run lint --fix"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@mui/x-data-grid": "^9.18.0",
    "@mui/x-virtualizer": "0.7.6",
    "@xrf/collections": "workspace:*",
    "@xrf/format": "workspace:*",
    "@xrf/logging": "workspace:*",
    "@xrf/math": "workspace:*",
    "@xrf/path": "workspace:*",
    "@xrf/react": "workspace:*",
    "@xrf/search": "workspace:*",
    "@xrf/syntax": "workspace:*",
    "@xrf/types": "workspace:*",
    "@xyflow/react": "catalog:",
    "clsx": "2.1.1",
    "date-fns": "catalog:",
    "react-colorful": "^5.8.1",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@xrf/toolchain": "workspace:*",
    "eslint": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "^10.6.7",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
