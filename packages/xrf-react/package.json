{
  "name": "@xrf/react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "React hooks and helpers that need no theme: polling, throttled drafts, element sizes, the window width, copying, forced updates, partial changes, ranked search, and an error boundary.",
  "exports": {
    "./*": "./src/*/index.ts"
  },
  "imports": {
    "#/*": "./src/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint . --max-warnings 0 --cache --cache-location target/eslint/cache.json --cache-strategy content",
    "format": "prettier --write --ignore-path ../../.prettierignore \"**/*.(js|cjs|mjs|ts|tsx|md)\" && pnpm run lint --fix"
  },
  "dependencies": {
    "@xrf/logging": "workspace:*",
    "@xrf/search": "workspace:*",
    "@xrf/types": "workspace:*"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "@xrf/toolchain": "workspace:*"
  }
}
