{
  "name": "@xrf/path",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Path handling with no application subject: separators of both styles, names, directories, comparison keys, head truncation, X-Ray logical paths and file extensions.",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#/*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint . --max-warnings 0 --cache --cache-location target/eslint/cache.json --cache-strategy content",
    "format": "prettier --write --ignore-path ../../.prettierignore \"**/*.(js|cjs|mjs|ts|md)\" && pnpm run lint --fix"
  },
  "dependencies": {
    "@xrf/types": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "@xrf/toolchain": "workspace:*"
  }
}
