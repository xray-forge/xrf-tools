{
  "name": "@xrf/math",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Numeric helpers: clamp, saturate, wrap and mix, three-component vectors and named-axis points, rigid transforms, angles, series, the engine's epsilons and its vector angles, render space, sphere-fit distance, raw colours, a 2D pan-zoom camera and waveform peaks.",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#/*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint . --max-warnings 0 --cache --cache-location target/eslint/cache.json --cache-strategy content",
    "format": "prettier --write --ignore-path ../../.prettierignore \"**/*.(js|cjs|mjs|ts|md)\" && pnpm run lint --fix"
  },
  "dependencies": {
    "@xrf/types": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "@xrf/toolchain": "workspace:*"
  }
}
